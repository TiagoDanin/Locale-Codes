{
	"name": "locale-codes",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./dist/index": "./dist/index.js",
		"./dist/types": "./dist/types.js",
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"preferGlobal": false,
	"version": "2.0.0",
	"description": " Language codes & country codes",
	"author": {
		"name": "Tiago Danin",
		"email": "TiagoDanin@outlook.com",
		"url": "https://TiagoDanin.github.io"
	},
	"license": "MIT",
	"keywords": [
		"code",
		"code-locality",
		"codes",
		"country",
		"i18n",
		"iso",
		"iso639",
		"iso639-1",
		"iso639-2",
		"json",
		"lang",
		"language",
		"languages",
		"lcid",
		"locale",
		"locales",
		"localization",
		"module",
		"tag",
		"windows"
	],
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
		"build": "npm run clean && tsc && node script/build-esm.js",
		"dev": "tsc --watch",
		"start": "node dist/index.js",
		"test": "npm run build && node tests/test.js && node tests/esm.test.mjs",
		"lint": "tsc --noEmit",
		"prepublishOnly": "npm run build"
	},
	"engines": {
		"node": ">=18"
	},
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/TiagoDanin/Locale-Codes.git"
	},
	"homepage": "https://TiagoDanin.github.io/Locale-Codes",
	"bugs": {
		"url": "https://github.com/TiagoDanin/Locale-Codes/issues"
	},
	"github": {
		"name": "Locale-Codes",
		"owner": "TiagoDanin"
	},
	"files": [
		"LICENSE",
		"README.md",
		"dist/",
		"!dist/test.*",
		"!dist/index.test-d.ts"
	],
	"dependencies": {
		"iso639-codes": "^2.0.0",
		"langs": "^2.0.0",
		"windows-locale": "^2.0.0"
	},
	"devDependencies": {
		"@types/node": "^16.18.0",
		"tsd": "^0.13.1",
		"typescript": "^4.9.0"
	}
}
